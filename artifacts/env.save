# Copy to .env in the repo root, then fill in the two secrets below.
#
# This one file feeds two consumers:
#   * docker compose reads it automatically (it sits next to docker-compose.yml)
#     to interpolate ${NEO4J_PASSWORD} and ${SESSION_SECRET}. `make up` fails
#     loudly if either is unset.
#   * the host API under `make dev`, which is also configured from this file.
# The container API does not read it: compose passes the values it needs
# explicitly, with container-side URIs and paths that override the host ones here.
#
# .env is gitignored. Never commit real secrets.

# --- Required. No defaults; compose refuses to start without them. ---
# Neo4j's password. Generate one: openssl rand -hex 16
NEO4J_PASSWORD=788c66c2e2e6ce6e0131df8c079341c0
# Signs API session cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=81f86b98dff8f1a0e00c87cbb912d13a417d2641edcc963f84deefb4427dfb53

# --- Host development (`make dev`). Compose overrides these in-container. ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
ILLUMINATE_DATA_DIR=./data
ILLUMINATE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Default model tiers (overridable per workspace in Settings). The OpenAI key itself is
# entered in the UI (Settings › Connectors) and stored encrypted in the data dir.
ILLUMINATE_MODEL_STRONG=gpt-5
ILLUMINATE_MODEL_FAST=gpt-5-mini

# BACKUP is deliberately absent: setting it here would restore the graph on every
# start. Pass it per-invocation instead — `BACKUP=latest make up`.

# Local override keeps this checkout separate from the existing uc7 database.
COMPOSE_FILE=docker-compose.yml:compose.local
