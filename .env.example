# Copy to api/.env (or export) for local development.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=illuminate-dev
ILLUMINATE_DATA_DIR=./data
ILLUMINATE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Default model tiers (overridable per workspace in Settings). The OpenAI key itself is
# entered in the UI (Settings › Connectors) and stored encrypted in the data dir.
ILLUMINATE_MODEL_STRONG=gpt-5
ILLUMINATE_MODEL_FAST=gpt-5-mini

# A deployment can coordinate all of its processes through its own durable
# cache authority. Keep bearer and scope keys in Replit Secrets, not this file.
# ILLUMINATE_FETCH_CACHE_URL=http://127.0.0.1:8000
# ILLUMINATE_FETCH_CACHE_NAMESPACE=illuminate-v1
# ILLUMINATE_FETCH_CACHE_TOKEN=replace-with-a-shared-secret
# ILLUMINATE_FETCH_CACHE_SCOPE_KEY=replace-with-a-stable-project-shared-secret
# ILLUMINATE_FETCH_CACHE_REQUIRED=true
#
# Set this on a self-coordinating deployment. It uses Replit's managed
# PostgreSQL database, which is isolated from analytical Neo4j/Cypher access.
# ILLUMINATE_FETCH_CACHE_AUTHORITY_ENABLED=true
# Apply api/migrations/001_fetch_cache.sql to the managed database before start.
