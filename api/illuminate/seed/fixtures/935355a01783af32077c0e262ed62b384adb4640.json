onnected_category_id": 1, "aliases": ["CACI International", "CACI International Inc", "CACI Intl", "California Analysis Center, Inc.", "Consolidated Analysis Center, Inc."], "types": ["Organization", "Business", "Public Company"], "extensions": {"Org": {"name": "CACI International", "name_nick": null, "employees": null, "revenue": 1938000000, "fedspending_id": "53539", "lda_registrant_id": null}, "Business": {"annual_profit": null, "assets": null, "marketcap": null, "net_income": null, "aum": null}, "PublicCompany": {"ticker": "CAI", "sec_cik": 16058}}, "tags": ["defence"]}, "links": {"self": "https://littlesis.org/entities/911-CACI_International_Inc"}}, {"type": "entities", "id": 384, "attributes": {"id": 384, "name": "Oshkosh Corporation", "blurb": "Specialty trucks and truck bodies", "summary": "Contracted in 2011: $4.94 billion \r\nTotal 2011 revenue: $7.6 billion \r\nContracted in 2012, so far: $430 million\r\nCompany Profile\r\n\r\nOshkosh, headquartered in Oshkosh, Wisc., is primarily concerned with the design and manufacture of vehicles and vehicle bodies and has been a contractor of the U.S. Department of Defense for over 80 years, becoming its leading supplier of heavy and medium payload tactical trucks. \r\n\r\nThe Department of Defense is responsible for Oshkosh\u2019s top 10 contracts from 2011, which ranged from $125 million to just over $900 million. The biggest contracts for Oshkosh in 2011 were for ground effect vehicles.A majority of the contracts, $4.93 billion, arose from the U.S. Army, according to USASpending.gov. However, compared to a year earlier, contracts won by Oshkosh have dropped significantly, from $7.2 billion in 2010 to $4.94 billion in 2011.", "website": "https://www.oshkoshcorp.com/", "parent_id": null, "primary_ext": "Org", "updated_at": "2022-10-28T01:06:49Z", "start_date": null, "end_date": null, "connected_relationship_ids": "566415", "connected_category_id": 1, "aliases": ["Oshkosh", "Oshkosh Corporation", "Oshkosh Truck Company"], "types": ["Organization", "Business", "Public Company"], "extensions": {"Org": {"name": "Oshkosh", "name_nick": null, "employees": null, "revenue": 6307300000, "fedspending_id": null, "lda_registrant_id": null}, "Business": {"annual_profit": null, "assets": null, "marketcap": null, "net_income": null, "aum": null}, "PublicCompany": {"ticker": "OSK", "sec_cik": 775158}}, "tags": []}, "links": {"self": "https://littlesis.org/entities/384-Oshkosh_Corporation"}}, {"type": "entities", "id": 144055, "attributes": {"id": 144055, "name": "U.S. Global Leadership Coalition", "blurb": null, "summary": "A nonprofit organization formed by a coalition of American businesses and NGOs, senior national security and foreign policy experts, faith-based and community leaders from across the United States who promote increased support for the United States\u2019 diplomatic and development efforts among both politicians and the public", "website": "https://www.usglc.org", "parent_id": null, "primary_ext": "Org", "updated_at": "2026-05-17T03:42:27Z", "start_date": "2003-00-00", "end_date": null, "connected_relationship_ids": "1897058", "connected_category_id": 1, "aliases": ["U.S. Global Leadership Coalition", "US Global Leadership Coalition", "USGLC"], "types": ["Organization", "Other Not-for-Profit", "Policy/Think Tank", "Government Advisory Body"], "extensions": {"Org": {"name": "US Global Leadership Coalition", "name_nick": null, "employees": null, "revenue": null, "fedspending_id": null, "lda_registrant_id": null}}, "tags": []}, "links": {"self": "https://littlesis.org/entities/144055-U.S._Global_Leadership_Coalition"}}]}}